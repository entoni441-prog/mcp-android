<?xml version="1.0" encoding="UTF-8"?>
<!-- DISABLED experimental template. Not installed. Placeholders must be reviewed. -->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Experimental Guardian: owner-logon restart only; DO NOT install/enable before acceptance</Description>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
      <UserId>__USER_SID__</UserId>
      <Delay>PT20S</Delay>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Owner">
      <UserId>__USER_SID__</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>5</Count>
    </RestartOnFailure>
    <StartWhenAvailable>true</StartWhenAvailable>
    <Enabled>false</Enabled>
  </Settings>
  <Actions Context="Owner">
    <Exec>
      <Command>__NODE_EXE__</Command>
      <Arguments>"__GUARDIAN_RUNNER_NOT_YET_IMPLEMENTED__" run "__AUTHORIZED_MANIFEST__"</Arguments>
      <WorkingDirectory>__EXPERIMENT_REPO__</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
