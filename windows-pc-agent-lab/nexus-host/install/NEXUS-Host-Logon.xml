<?xml version="1.0" encoding="UTF-16"?>
<!-- NEXUS NEXT: start NEXUS Host (nexus.mjs: Host + tunnel) when THE OWNER signs in, in his session (GUI available).
     Placeholders __USER__, __NODE__, __HOSTDIR__ are filled by the installer (ACTIVATE-NEXT). One instance only. -->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo><Description>NEXUS Host — start at owner logon (NEXUS NEXT). No autologon: Windows sign-in stays with the owner.</Description></RegistrationInfo>
  <Triggers><LogonTrigger><Enabled>true</Enabled><UserId>__USER__</UserId><Delay>PT20S</Delay></LogonTrigger></Triggers>
  <Principals><Principal id="Owner"><UserId>__USER__</UserId><LogonType>InteractiveToken</LogonType><RunLevel>LeastPrivilege</RunLevel></Principal></Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries><StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <RestartOnFailure><Interval>PT1M</Interval><Count>5</Count></RestartOnFailure>
    <StartWhenAvailable>true</StartWhenAvailable><Enabled>true</Enabled>
  </Settings>
  <Actions Context="Owner"><Exec><Command>__NODE__</Command><Arguments>nexus.mjs</Arguments><WorkingDirectory>__HOSTDIR__</WorkingDirectory></Exec></Actions>
</Task>
